# ============================================================
# Environment Variables — Ask My Documents RAG System
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider API Keys (Verified Zero-Training APIs) ──────

# 1. Groq Free API (Primary Recommended - Llama 3.3 70B & Llama 3.1 8B)
# Free Tier + Zero Training Data Policy
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Ollama Local LLM Runner (100% Offline & Air-Gapped)
# Auto-detects best local model (Llama 3.3, Qwen 2.5, Mistral) at http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434/v1

# 3. DeepSeek API (Zero Model Training Policy)
# Get key at: https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk_your_deepseek_api_key_here

# 4. OpenAI API (GPT-4o / GPT-4o-mini - Zero Training API Policy)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_api_key_here

# 5. Anthropic Claude API (Claude 3.5 Sonnet - Zero Training Commercial Terms)
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# 6. OpenRouter Multi-Model API (Optional Multi-Provider Gateway)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ── System Configuration Overrides ───────────────────────────
# RAG_LOG_LEVEL=INFO
# RAG_CHROMA_DIR=./chroma_db
FRONTEND_URL=https://your-actual-domain-or-ip

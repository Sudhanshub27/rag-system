# ============================================================
# Environment Variables — RAG System
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider API Keys ──────────────────────────────────────
# The system automatically detects whichever API key you provide.

# 1. DeepSeek (Default & Low Cost)
# Get key at: https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 2. OpenRouter (Access to 100s of free & paid models)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Google Gemini (Fast & Generous Free Tier)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Anthropic Claude (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 5. OpenAI GPT-4o (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# ── Reranking & Vector Store ──────────────────────────────────
# Cohere (optional — for Cohere Rerank instead of cross-encoder)
COHERE_API_KEY=your_cohere_api_key_here

# ── Optional Overrides ─────────────────────────────────────────
# Override config/settings.yaml values without editing the file.
# RAG_LOG_LEVEL=DEBUG
# RAG_CHROMA_DIR=./chroma_db
